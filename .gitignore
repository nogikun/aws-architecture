.direnv/
.DS_Store

# エージェント向けスキルの実体・symlink (ローカルの導入設定であり、リポジトリでは配布しない)
.agents/
.claude/skills/
.kiro/skills/

# Python / uv
__pycache__/
.pytest_cache/
.venv/

# arch-builder
# 取り込んだ AWS 公式アイコン (ZIP から `arch icons build` で再生成できる)
skills/arch-builder/icons/
# 検証の実行結果 (iteration-N の生成物は手順書・レビューと分けて無視する)
arch-builder-workspace/iteration-*/
# 作図ループの作業ファイル
.arch-loop/
.archdraw-loop/
# 評価・試作の .drawio はアイコンの SVG (AWS 公式アイコンなど) をそのまま埋め込むので、再配布しない。
# 定義 (.py / .yaml) と PNG だけを残し、.drawio は定義から archdraw build で作り直す
arch-builder-workspace/**/*.drawio
